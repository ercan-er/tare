{
  "name": "tare-storefront",
  "version": "1.0.0",
  "private": true,
  "description": "End-to-end sample storefront used as a verification target for IronBee",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx db/migrate.ts",
    "db:seed": "tsx db/seed.ts",
    "db:reset": "tsx db/migrate.ts && tsx db/seed.ts"
  },
  "dependencies": {
    "@libsql/client": "0.15.4",
    "firebase": "11.6.0",
    "firebase-admin": "13.2.0",
    "next": "15.5.22",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@types/node": "22.14.1",
    "@types/react": "19.1.2",
    "@types/react-dom": "19.1.2",
    "tsx": "4.19.3",
    "typescript": "5.8.3"
  },
  "engines": {
    "node": ">=20"
  }
}
