# ─── Database (libSQL / SQLite) ───────────────────────────────────────────────
# A plain SQLite file is enough for local development:
TURSO_DATABASE_URL=file:local.db
TURSO_AUTH_TOKEN=

# Vercel's filesystem is not persistent. Use Turso for anything deployed:
# TURSO_DATABASE_URL=libsql://<database>-<user>.turso.io
# TURSO_AUTH_TOKEN=<token from: turso db tokens create>

# ─── Firebase (client / browser) ──────────────────────────────────────────────
# Firebase console → Project settings → General → Your apps → Web
# These values are public by design; they ship in the client bundle.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Analytics (GA4). Only present after enabling Google Analytics for the web app.
# Performance Monitoring works without it; Analytics events no-op without it.
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ─── Firebase Admin (server, ID token verification) ───────────────────────────
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Private key on one line, with \n escapes, wrapped in quotes:
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ─── Fault injection for verification testing ─────────────────────────────────
# Leave empty. Set one value at a time, on preview only, to prove a verifier
# actually catches the defect. Values: slow | contract | error | empty | stock
FAULT_INJECT=
