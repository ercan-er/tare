# ─── Database (libSQL / SQLite) ───────────────────────────────────────────────
# A plain SQLite file is enough for local development:
TURSO_DATABASE_URL=file:local.db
TURSO_AUTH_TOKEN=

# Vercel's filesystem is not persistent. Use Turso for anything deployed:
# TURSO_DATABASE_URL=libsql://<database>-<user>.turso.io
# TURSO_AUTH_TOKEN=<token from: turso db tokens create>

# ─── Firebase (client / browser) ──────────────────────────────────────────────
# Firebase console → Project settings → General → Your apps → Web
# These values are public by design; they ship in the client bundle.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Analytics (GA4). Only present after enabling Google Analytics for the web app.
# Performance Monitoring works without it; Analytics events no-op without it.
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ─── Firebase Admin (server, ID token verification) ───────────────────────────
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Private key on one line, with \n escapes, wrapped in quotes:
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ─── Stripe (test mode only) ──────────────────────────────────────────────────
# Stripe dashboard → Developers → API keys → Secret key (test mode).
# A live key (sk_live_…) is rejected on purpose: this store never takes real money.
STRIPE_SECRET_KEY=

# Local: stripe listen --forward-to localhost:3000/api/webhooks/stripe
# Vercel: Stripe dashboard → Developers → Webhooks → your endpoint → Signing secret
# Without this the webhook cannot verify signatures and no order is ever paid.
STRIPE_WEBHOOK_SECRET=

# Optional. Signs first-visit HELLO15 tokens so they expire after 24h server-side.
# Falls back to STRIPE_WEBHOOK_SECRET, then a local default.
PROMO_SIGNING_SECRET=

# Optional. Stripe returns the buyer to this origin. Leave empty to derive it
# from the incoming request, which is what preview deployments need.
NEXT_PUBLIC_SITE_URL=

# Demo only. Set to 1 to mark orders "paid" instantly at checkout, skipping
# Stripe and the webhook entirely (empties the cart, decrements stock, starts
# shipment tracking). Leave EMPTY in production so real payment confirmation
# still happens exclusively through the signed Stripe webhook.
DEMO_INSTANT_PAID=

# ─── OpenTelemetry ────────────────────────────────────────────────────────────
# Leave the endpoint empty to disable tracing entirely. Spans go out as
# OTLP over HTTP with protobuf encoding; the signal path (/v1/traces) is
# appended automatically.
OTEL_EXPORTER_OTLP_ENDPOINT=
# Standard OTLP header syntax: key1=value1,key2=value2
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=tare-storefront
# Set to "debug" to see the collector's real HTTP status. Without it a 4xx
# from the collector is reported as a successful export and stays invisible.
OTEL_LOG_LEVEL=

# ─── Fault injection for verification testing ─────────────────────────────────
# Leave empty. Set one value at a time, on preview only, to prove a verifier
# actually catches the defect. Values: slow | contract | error | empty | stock
FAULT_INJECT=
